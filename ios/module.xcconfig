//
// ti.admob.unified - iOS Module Configuration
// Build settings for Google Mobile Ads SDK integration
//

// Minimum iOS version for Google Mobile Ads SDK
IPHONEOS_DEPLOYMENT_TARGET = 12.0

// Framework search paths for platform frameworks
FRAMEWORK_SEARCH_PATHS = $(inherited) $(PROJECT_DIR)/platform

// Link frameworks automatically (Titanium 6.2.2+)
// The following frameworks are automatically detected from platform/ folder:
// - GoogleMobileAds.xcframework
// - UserMessagingPlatform.xcframework
// - AppLovinSDK.xcframework
// - AppLovinAdapter.xcframework
// - InMobiSDK.xcframework
// - InMobiAdapter.xcframework
// - IronSource.xcframework
// - IronSourceAdapter.xcframework
// - IronSourceAdQualitySDK.xcframework
// - LiftoffMonetizeAdapter.xcframework
// - MetaAdapter.xcframework
// - FBAudienceNetwork.xcframework
// - UnityAds.xcframework
// - UnityAdapter.xcframework
// - VungleAdsSDK.xcframework

// Required system frameworks
OTHER_LDFLAGS = $(inherited) -framework AppTrackingTransparency -framework AdSupport -framework CoreTelephony -framework SystemConfiguration -framework MessageUI -framework CoreLocation -framework WebKit -framework StoreKit -framework MediaPlayer -framework CFNetwork -framework AudioToolbox -framework AVFoundation -framework Security -framework ImageIO -ObjC

// Compiler flags
OTHER_CFLAGS = $(inherited) -DUSE_TI_UIDIRECTION

// Swift support (for some mediation adapters)
SWIFT_VERSION = 5.0
ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES

// Privacy manifests inclusion
COPY_PHASE_STRIP = NO
ENABLE_BITCODE = NO
