# ===================================================================
# TITANIUM MODULE .GITIGNORE
# ===================================================================

# macOS system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ===================================================================
# BUILD ARTIFACTS (not versioned)
# ===================================================================

# Generated module files
*.zip
*.aar

# Build directories
tmp/
bin/
build/
dist/
android/dist
ios/dist
# ===================================================================
# iOS SPECIFIC
# ===================================================================

# Xcode user-specific files
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.xcworkspace
!default.xcworkspace
xcuserdata/
profile
*.moved-aside
DerivedData/

# iOS build artifacts
ios/metadata.json
ios/ti.admob-iphone-*.zip
ios/ti.admob.unified-iphone-*.zip
ios/dist/
ios/build/
ios/titanium.xcconfig.bak
ios/*.xcodeproj/project.xcworkspace/xcuserdata/*
mediation/*/ios/metadata.json
mediation/*/ios/ti.admob.unified.mediation-iphone-*.zip
mediation/*/ios/dist/
mediation/*/ios/build/
mediation/*/ios/titanium.xcconfig.bak
mediation/*/ios/*.xcodeproj/project.xcworkspace/xcuserdata/*

# CocoaPods (regenerated with install_frameworks.sh)
ios/Pods/
ios/*.xcworkspace
mediation/*/ios/Pods/
mediation/*/ios/*.xcworkspace

# ===================================================================
# ANDROID SPECIFIC
# ===================================================================

# Android build artifacts
android/libs/
android/build.properties
android/dist/
android/build/
android/java-sources.txt
android/.gradle/
android/local.properties
mediation/*/android/libs/
mediation/*/android/build.properties
mediation/*/android/dist/
mediation/*/android/build/
mediation/*/android/java-sources.txt
mediation/*/android/.gradle/
mediation/*/android/local.properties

# Gradle wrapper
android/gradle/wrapper/gradle-wrapper.jar
android/gradle/wrapper/gradle-wrapper.properties

# ===================================================================
# FRAMEWORKS (versioned for distribution)
# ===================================================================

# Frameworks are required to build and distribute the modules.
# Keep ios/platform/, mediation/*/ios/platform/ and android/lib/ versioned.

# ===================================================================
# DEVELOPMENT & TESTING
# ===================================================================

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test results
TESTS-*.xml
coverage/
.codebase-memory/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# ===================================================================
# LOGS & TEMPORARY FILES
# ===================================================================

*.log
*.tmp
*.temp
.cache/

# Screenshots pasted into the repository root are personal working files.
# Documentation screenshots in subdirectories remain versioned.
/*.png
/*.jpg
/*.jpeg
/Captura de pantalla*

# Python tooling caches
__pycache__/
*.pyc

# Personal state, diagnostics and signing material
/audit-evidence/
/.agents/
/AGENTS.md
/HANDOFF.md
/docs/project/
/ANALISIS_*.md
/AUDIT-*.md
/PLAN-*.md
/instrucciones.md
*.bak
*.bak.*
*.orig
*.rej
