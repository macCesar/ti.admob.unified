# Podfile para ti.admob.unified iOS Module
# Equivalente al build.gradle de Android con 8 networks de mediación
# Basado en la documentación oficial de Titanium Hyperloop

# This is required for CocoaPods 1.x (from Titanium docs)
install! 'cocoapods',
         :integrate_targets => false

platform :ios, '13.0'

target 'ti.admob.unified' do
  use_frameworks!

  # ===================================================================
  # CORE GOOGLE MOBILE ADS SDK
  # ===================================================================

  # Core Google Mobile Ads SDK - Latest stable version (matches Android 22.6.0)
  pod 'Google-Mobile-Ads-SDK', '~> 12.9.0'

  # User Messaging Platform SDK for GDPR/CCPA/UMP consent (matches Android 2.1.0)
  pod 'GoogleUserMessagingPlatform', '~> 2.4.0'

  # ===================================================================
  # MEDIATION ADAPTERS - 8 Networks (same as Android)
  # ===================================================================

  # Facebook Audience Network (Meta) - VERIFICADO
  pod 'GoogleMobileAdsMediationFacebook', '~> 6.20.1.0'

  # InMobi - Strong in international markets - VERIFICADO
  pod 'GoogleMobileAdsMediationInMobi', '~> 10.8.6.0'

  # Unity Ads - Perfect for gaming apps, high video eCPM - VERIFICADO
  pod 'GoogleMobileAdsMediationUnity', '~> 4.16.0.0'

  # AppLovin MAX - Premium mediation platform, excellent optimization - VERIFICADO
  pod 'GoogleMobileAdsMediationAppLovin', '~> 13.3.1.0'

  # Vungle - Video advertising specialists, great for rewarded ads - VERIFICADO
  pod 'GoogleMobileAdsMediationVungle', '~> 7.5.3.0'

  # IronSource - Gaming-focused, high retention campaigns - VERIFICADO
  pod 'GoogleMobileAdsMediationIronSource', '~> 8.10.0.0.0'

  # ===================================================================
  # OPTIONAL: Additional popular networks (uncomment if needed)
  # ===================================================================
  # pod 'GoogleMobileAdsMediationChartboost'
  # pod 'GoogleMobileAdsMediationAdColony'
  # pod 'GoogleMobileAdsMediationTapjoy'
  # pod 'GoogleMobileAdsMediationMaio'

end
